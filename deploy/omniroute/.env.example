# Copy to .env on the Oracle VM. NEVER commit the real .env.
NODE_ENV=production
PORT=20128
HOSTNAME=0.0.0.0

# OmniRoute dashboard/auth secrets — generate long random values.
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
INITIAL_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
API_KEY_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS

# Optional: only configure providers that you are authorized to use.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
